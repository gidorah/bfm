# Fast-env run isolation (generated by tools/fast-env/fast-env.sh — never commit)
_work-tmp/fast-env/
# Pinned WireMock tool cache (downloaded + verified by `fast-env.sh prepare` — never commit)
_work-tmp/fast-env-tool-cache/
